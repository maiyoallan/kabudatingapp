PORT=4000
# Set to the exact frontend origin in production, e.g. http://192.168.1.20:5173
CLIENT_ORIGIN=http://localhost:5173
# Comma-separated CIDR ranges permitted to connect. Example home/lab Wi-Fi:
# ALLOWED_CIDRS=192.168.1.0/24,10.0.0.0/24
# Leave empty for development. In production, configure your campus-approved subnet(s).
ALLOWED_CIDRS=
SESSION_TTL_MS=90000
MAX_MESSAGE_LENGTH=1000
